<%- include("partials/head") %>
<div class="columns two">
  <section class="card stack">
    <div>
      <h2 class="section-title">마이페이지</h2>
      <p class="hint">소개글과 표시 이름을 수정할 수 있습니다.</p>
    </div>
    <form method="post" action="/profile" class="form-grid">
      <input type="hidden" name="csrfToken" value="<%= csrfToken %>" />
      <label>
        표시 이름
        <input name="displayName" value="<%= currentUser.display_name %>" maxlength="30" required />
      </label>
      <label>
        소개글
        <textarea name="bio" maxlength="300"><%= currentUser.bio %></textarea>
      </label>
      <button class="button button-primary" type="submit">프로필 저장</button>
    </form>
  </section>

  <section class="card stack">
    <div>
      <h2 class="section-title">비밀번호 변경</h2>
      <p class="hint">현재 비밀번호 확인 후 변경됩니다.</p>
    </div>
    <form method="post" action="/profile/password" class="form-grid">
      <input type="hidden" name="csrfToken" value="<%= csrfToken %>" />
      <label>
        현재 비밀번호
        <input name="currentPassword" type="password" required />
      </label>
      <label>
        새 비밀번호
        <input name="newPassword" type="password" minlength="10" required />
      </label>
      <button class="button" type="submit">비밀번호 변경</button>
    </form>
  </section>
</div>

<section class="card stack" style="margin-top: 20px;">
  <div class="compact">
    <h3 class="section-title">최근 송금 상세 내역</h3>
    <span class="pill"><%= transfers.length %>건</span>
  </div>
  <div class="table-wrap">
    <table>
      <thead>
        <tr>
          <th>시각</th>
          <th>방향</th>
          <th>상대</th>
          <th>금액</th>
          <th>메모</th>
        </tr>
      </thead>
      <tbody>
        <% for (const transfer of transfers) { %>
          <tr>
            <td><%= formatDate(transfer.created_at) %></td>
            <td><%= transfer.sender_id === currentUser.id ? '보냄' : '받음' %></td>
            <td><%= transfer.sender_id === currentUser.id ? transfer.recipient_display_name : transfer.sender_display_name %></td>
            <td><%= formatCurrency(transfer.amount) %>원</td>
            <td><%= transfer.note %></td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>
</section>
<%- include("partials/foot") %>
