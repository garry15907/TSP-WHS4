<%- include("partials/head") %>
<section class="card stack">
  <div>
    <h2 class="section-title">관리자 대시보드</h2>
    <p class="hint">플랫폼의 사용자, 상품, 신고 현황을 한 곳에서 관리합니다.</p>
  </div>
  <div class="admin-grid">
    <div class="stat"><strong>활성 사용자</strong><div><%= summary.activeUsers %>명</div></div>
    <div class="stat"><strong>활성 상품</strong><div><%= summary.activeProducts %>개</div></div>
    <div class="stat"><strong>차단 상품</strong><div><%= summary.blockedProducts %>개</div></div>
    <div class="stat"><strong>휴면 계정</strong><div><%= summary.dormantUsers %>명</div></div>
    <div class="stat"><strong>총 신고</strong><div><%= summary.reportCount %>건</div></div>
    <div class="stat"><strong>총 송금</strong><div><%= summary.transferCount %>건</div></div>
  </div>
</section>

<section class="card stack" style="margin-top: 20px;">
  <h3 class="section-title">사용자 관리</h3>
  <div class="table-wrap">
    <table>
      <thead>
        <tr>
          <th>ID</th>
          <th>사용자</th>
          <th>권한</th>
          <th>상태</th>
          <th>잔액</th>
          <th>신고</th>
          <th>변경</th>
        </tr>
      </thead>
      <tbody>
        <% for (const user of users) { %>
          <tr>
            <td><%= user.id %></td>
            <td><strong><%= user.display_name %></strong><br /><small>@<%= user.username %></small></td>
            <td><%= user.role %></td>
            <td><%= user.status %></td>
            <td><%= formatCurrency(user.wallet_balance) %>원</td>
            <td><%= user.report_count %></td>
            <td>
              <form method="post" action="/admin/users/<%= user.id %>/status" class="compact">
                <input type="hidden" name="csrfToken" value="<%= csrfToken %>" />
                <select name="status">
                  <option value="active">active</option>
                  <option value="dormant">dormant</option>
                  <option value="banned">banned</option>
                </select>
                <button class="button" type="submit">저장</button>
              </form>
            </td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>
</section>

<section class="card stack" style="margin-top: 20px;">
  <h3 class="section-title">상품 관리</h3>
  <div class="table-wrap">
    <table>
      <thead>
        <tr>
          <th>ID</th>
          <th>상품</th>
          <th>판매자</th>
          <th>상태</th>
          <th>신고</th>
          <th>변경</th>
        </tr>
      </thead>
      <tbody>
        <% for (const product of products) { %>
          <tr>
            <td><%= product.id %></td>
            <td><a href="/products/<%= product.id %>"><%= product.title %></a></td>
            <td><%= product.seller_display_name %></td>
            <td><%= product.status %></td>
            <td><%= product.report_count %></td>
            <td>
              <form method="post" action="/admin/products/<%= product.id %>/status" class="compact">
                <input type="hidden" name="csrfToken" value="<%= csrfToken %>" />
                <select name="status">
                  <option value="active">active</option>
                  <option value="blocked">blocked</option>
                  <option value="sold">sold</option>
                  <option value="deleted">deleted</option>
                </select>
                <button class="button" type="submit">저장</button>
              </form>
            </td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>
</section>

<section class="card stack" style="margin-top: 20px;">
  <h3 class="section-title">최근 신고</h3>
  <div class="table-wrap">
    <table>
      <thead>
        <tr>
          <th>시각</th>
          <th>신고자</th>
          <th>대상</th>
          <th>대상 ID</th>
          <th>사유</th>
        </tr>
      </thead>
      <tbody>
        <% for (const report of reports) { %>
          <tr>
            <td><%= formatDate(report.created_at) %></td>
            <td><%= report.reporter_display_name %></td>
            <td><%= report.target_type %></td>
            <td><%= report.target_id %></td>
            <td><%= report.reason %></td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>
</section>
<%- include("partials/foot") %>
